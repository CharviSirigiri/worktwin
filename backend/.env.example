# Copy to .env and fill in. Never commit .env.

# Gemini (AI Studio key). Leave empty to run in mock mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# adk (default) or genai
AGENT_RUNTIME=adk
# Force mock mode even with a key: true/false
MOCK_LLM=

# local (JSON files in backend/data) or firestore
STORE=local

# GitHub personal access token (read-only: public_repo, or repo for private repos)
GITHUB_TOKEN=

# Shared secret the ESP32 sends with each NFC tap
TAPIN_DEVICE_TOKEN=change-me

# Comma-separated frontend origins, or * during development
CORS_ORIGINS=*

TEAM_TIMEZONE=Asia/Kuala_Lumpur
